{
  "name": "mihenk-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.app.config.ts && node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "dev": "vite build --watch --mode development --config vite.app.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "lucide-react": "1.49.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
